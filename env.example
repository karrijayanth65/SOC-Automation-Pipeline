# Configuration inventory. Copy to a private .env; never commit actual secrets.
# Bind credentials in n8n. Importing the workflow does not automatically read this file.
OPENAI_API_KEY=replace_locally
OPENAI_MODEL=gpt-4.1-mini
ABUSEIPDB_API_KEY=replace_locally
VIRUSTOTAL_API_KEY=replace_locally
DFIR_IRIS_API_KEY=replace_locally
DFIR_IRIS_URL=https://iris.example.invalid
SLACK_BOT_TOKEN=replace_locally
SLACK_CHANNEL_ID=REPLACE_WITH_CHANNEL_ID
N8N_URL=https://n8n.example.invalid
WEBHOOK_SHARED_SECRET=replace_with_a_unique_local_secret
# Optional replacement model adapter; not configured in the supplied workflow.
OLLAMA_URL=http://localhost:11434
